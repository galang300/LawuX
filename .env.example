# Salin menjadi .env lalu isi. JANGAN commit file .env.
# Nilai kosong = memakai default yang tertulis di komentar.

PORT=3000
NODE_ENV=development            # development | production

# Wajib di production, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# OpenAI API (WAJIB) — dipakai untuk verifikasi RAG setiap tweet/retweet.
# Rujuk hanya mendukung OpenAI API resmi. Buat key di https://platform.openai.com/api-keys
# Tanpa key, endpoint sumber & tweet membalas 503 AI_NOT_CONFIGURED.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
VERIFY_MIN_SCORE=0.7            # 0..1, skor minimal agar tweet terbit

# Batas
MAX_PDF_MB=10
MAX_FETCH_MB=5
FETCH_TIMEOUT_MS=15000
MIN_SOURCE_TEXT_CHARS=200
MAX_CHUNKS_PER_SOURCE=150

# Lokasi data
DB_PATH=./data/rujuk.db
UPLOAD_DIR=./uploads
